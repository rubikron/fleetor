{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fleetor-pty-spike",
  "version": "0.0.0",
  "identifier": "dev.fleetor.pty-spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cargo build -p fleetor-cli --bin fleet && npm run dev",
    "beforeBuildCommand": "cargo build --release -p fleetor-cli --bin fleet && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FLEETOR — pty spike",
        "width": 1024,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14.35,
          "y": 20.35
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
